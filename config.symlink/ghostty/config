# =============================================================================
# Font Settings
# =============================================================================
font-family = JetBrainsMono NF
font-family = Noto Sans CJK TC Bold
font-size = 18
font-feature = liga
font-feature = calt
# macOS 字形加粗描邊，提升清晰度（不夠加 strength，過頭往下）
font-thicken = true
font-thicken-strength = 128

# =============================================================================
# Cursor
# =============================================================================
cursor-style = underline
cursor-style-blink = false

# =============================================================================
# Window
# =============================================================================
window-padding-x = 3
window-padding-y = 3
window-padding-balance = true
background-opacity = 1.0
macos-titlebar-style = tabs
window-decoration = true
window-save-state = never
window-inherit-working-directory = true
window-inherit-font-size = true

# =============================================================================
# Theme (auto follows system appearance)
# =============================================================================
theme = dark:bew-dark,light:bew-light

# =============================================================================
# Shell Integration
# =============================================================================
shell-integration = zsh
shell-integration-features = cursor,sudo,no-title
# =============================================================================
# Performance & Scrollback
# =============================================================================
scrollback-limit = 100000

# =============================================================================
# Quick Terminal (全域熱鍵呼叫)
# =============================================================================
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.1

# =============================================================================
# Link & URL
# =============================================================================
link-url = true

# =============================================================================
# macOS
# =============================================================================
macos-window-shadow = true
# 讓 Option 當 Meta（送出 ESC 前綴），Claude Code 才收得到 Option+P 之類的 Meta 綁定
macos-option-as-alt = true

# =============================================================================
# Behavior
# =============================================================================
desktop-notifications = true
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true

# =============================================================================
# Clipboard (allow terminal programs to read/write clipboard via OSC 52)
# =============================================================================
clipboard-read = allow
clipboard-write = allow

# =============================================================================
# Keybindings
# =============================================================================
keybind = cmd+w=close_surface
keybind = cmd+shift+r=reload_config
keybind = cmd+q=quit

# 新視窗預設開成分頁（cmd+n 改為 new_tab）
keybind = cmd+n=new_tab

# Option+Arrow 原本綁 word navigation（\x1bb / \x1bf）。拿掉了：Ghostty 的
# keybind 優先於一切，這兩行會把 alt+←/→ 整個吃掉，於是 herdr 的
# focus_pane_left/right（config.toml 綁了 alt+left/right，gamepad 外掛的 dpad
# 也走這條）永遠收不到鍵——左右切 pane 死掉，游標還會在 pane 裡跳字。
# 上下沒這問題，因為 alt+↑/↓ 沒被覆寫。word jump 改用 M-b / M-f。
#
# 注意：光是刪掉那兩行不夠 —— Ghostty 內建預設就是 alt+arrow_left=esc:b，
# 行為與自訂的 text:\x1bb 相同。必須顯式 unbind 才會回到標準 CSI 編碼
# （macos-option-as-alt = true → ESC[1;3D/1;3C），herdr 才收得到 alt+←/→。
keybind = alt+left=unbind
keybind = alt+right=unbind

# 快速清屏
keybind = cmd+k=clear_screen

# Split 分割
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+enter=toggle_split_zoom


# Split 導航
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down

# 調整 split 大小
keybind = ctrl+shift+left=resize_split:left,20
keybind = ctrl+shift+right=resize_split:right,20
keybind = ctrl+shift+up=resize_split:up,20
keybind = ctrl+shift+down=resize_split:down,20
